APP_ENV=local
APP_DEBUG=true

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=bli_orders
DB_USERNAME=
DB_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# SMTP — email delivery for the in-app notifications (Phase 3b). Leave
# MAIL_HOST empty in local dev: sends are logged instead of attempted.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@businesslinks-pk.com
MAIL_FROM_NAME="BLI Order & Project Management System"

# AI providers — never sent to the frontend (see docs/ARCHITECTURE.md §10)
CLAUDE_API_KEY=
GEMINI_API_KEY=
CHATGPT_API_KEY=

# Google Drive — FAT/SAT photo & video storage (see docs/ARCHITECTURE.md §4.3.1).
# Service account only, never a personal account's OAuth token.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_DRIVE_FAT_SAT_FOLDER_ID=

# SLA / escalation defaults, overridable by Company Owner (§7.1)
AT_RISK_WARNING_DAYS=3
BLOCKER_ESCALATION_DAYS=7
TICKET_AUTO_CLOSE_BUSINESS_DAYS=5
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
BUSINESS_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
